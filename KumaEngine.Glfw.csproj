<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>KumaEngine.Glfw</Title>
    <Description>managed bindings for glfw</Description>
    <Copyright></Copyright>
    <PackageProjectUrl>https://github.com/KumaGameEngine/KumaEngine.Glfw</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/KumaGameEngine/KumaEngine.Glfw</RepositoryUrl>
    <PackageTags>glfw; bindings</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>3.5.1</Version>
  </PropertyGroup>

	<ItemGroup>
		<Folder Include="Source\Native\" />
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>

		<None Update="runtimes\win-x64\native\glfw.dll">
			<Pack>True</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x64\native\glfw.dll</PackagePath>
		</None>
		<None Update="runtimes\win-x86\native\glfw.dll">
			<Pack>True</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x86\native\glfw.dll</PackagePath>
		</None>
		
		<None Update="runtimes\linux-x64\native\libglfw.so">
			<Pack>True</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\linux-x64\native\libglfw.so</PackagePath>
		</None>

		<None Update="runtimes\osx-arm64\native\libglfw.dylib">
			<Pack>True</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\osx-arm64\native\libglfw.dylib</PackagePath>
		</None>
		<None Update="runtimes\osx-x64\native\libglfw.dylib">
			<Pack>True</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<PackagePath>runtimes\osx-x64\native\libglfw.dylib</PackagePath>
		</None>
	</ItemGroup>

</Project>
